# Development-only values. Do not reuse these credentials in production.
POSTGRES_PASSWORD=smallnext-local-only
POSTGRES_PORT=55432
DATABASE_URL=postgres://smallnext:smallnext-local-only@127.0.0.1:55432/smallnext
API_BIND_ADDRESS=127.0.0.1:8080
# Developer's Mac only. Register /development/suggestions only when explicitly ON.
DEVELOPMENT_SUBSCRIPTION_AI=0
# Required for explicit LAN binding. Generate a local random token; never commit it.
DEVELOPMENT_AI_TOKEN=
# User API is OFF. Set identifiers/credentials only in a local secret source before ON.
USER_SERVER_AI=0
FIREBASE_PROJECT_ID=
AI_ALLOWED_FIREBASE_UIDS=
# Firebase ADMIN service-account file stays on the server; never use Codex OAuth here.
FIREBASE_SERVICE_ACCOUNT_FILE=
OPENAI_API_KEY=
# #47 must verify exact gpt-6.1-sol API availability, full context limit, and prices.
AI_MODEL_CONFIRMED=0
AI_MODEL_CONTEXT_TOKENS=
AI_MAX_OUTPUT_TOKENS=
# Conservative micro-USD per million tokens; cover cache-write premiums too.
AI_INPUT_MICRO_USD_PER_MILLION=
AI_OUTPUT_MICRO_USD_PER_MILLION=
# Initial evaluation ceiling: at most 3 USD; monthly personal ceiling remains 10 USD.
AI_BUDGET_MICRO_USD=3000000
RUST_LOG=smallnext_api=info
