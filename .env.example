# Development-only values. Do not reuse these credentials in production.
POSTGRES_PASSWORD=smallnext-local-only
POSTGRES_PORT=55432
DATABASE_URL=postgres://smallnext:smallnext-local-only@127.0.0.1:55432/smallnext
API_BIND_ADDRESS=127.0.0.1:8080
# Developer's Mac only. Register /development/suggestions only when explicitly ON.
DEVELOPMENT_SUBSCRIPTION_AI=0
# Required for explicit LAN binding. Generate a local random token; never commit it.
DEVELOPMENT_AI_TOKEN=
# User API is OFF. Set identifiers/credentials only in a local secret source before ON.
USER_SERVER_AI=0
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
AI_ALLOWED_SUPABASE_UIDS=
# Only 1 opens the API to every active anonymous user (#237 beta).
AI_PUBLIC_ACCESS=0
# Server-only random value of at least 32 characters for HMAC(UID) daily counts.
AI_USAGE_HASH_KEY=
ANTHROPIC_API_KEY=
# #47 must verify exact claude-haiku-5-5 API access and retention before activation.
# Generation and independent check use adaptive thinking / xhigh.
AI_MODEL_CONFIRMED=0
AI_MODEL_CONTEXT_TOKENS=1000000
AI_MAX_OUTPUT_TOKENS=8192
# Long-context maximum rates, including 1h cache writes and thinking output.
AI_INPUT_MICRO_USD_PER_MILLION=1000000
AI_OUTPUT_MICRO_USD_PER_MILLION=2500000
# Initial evaluation uses 3 USD. #237 beta ceilings: 30 USD a month, 3 USD a day, 20 per user a day.
AI_BUDGET_MICRO_USD=3000000
AI_DAILY_BUDGET_MICRO_USD=3000000
AI_USER_DAILY_REQUESTS=20
RUST_LOG=smallnext_api=info
