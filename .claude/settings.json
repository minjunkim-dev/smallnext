{
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills",
        "ref": "v1.3.2"
      }
    }
  },
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true
  },
  "permissions": {
    "deny": [
      "Read(.env*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(!.env.example)",
      "Bash(gh pr merge *)",
      "Bash(git push * main)",
      "Bash(git push * *:main)",
      "Bash(git push * +main)",
      "Bash(git push *refs/heads/main*)",
      "Bash(gh api *protection*)",
      "Bash(gh api *rulesets*)",
      "Bash(gh repo edit *)",
      "Bash(gh pr merge)",
      "Bash(git push)"
    ],
    "ask": [
      "Bash(gh api *enqueuePullRequest*)",
      "Bash(gh api *mergePullRequest*)",
      "Bash(gh api *PullRequestAutoMerge*)",
      "Bash(gh api */merge*)",
      "Bash(gh api *-X*)",
      "Bash(gh api *--method*)",
      "Bash(gh api *Xp*)",
      "Bash(gh api *XP*)",
      "Bash(gh api *Xd*)",
      "Bash(gh api *XD*)",
      "Bash(gh api *=@*)",
      "Bash(gh api *--input*)",
      "Bash(gh api */secrets*)",
      "Bash(gh api */variables*)",
      "Bash(gh api */hooks*)",
      "Bash(gh api */keys*)",
      "Bash(gh api */collaborators*)",
      "Bash(gh api */invitations*)",
      "Bash(gh api */actions/permissions*)",
      "Bash(gh api */environments*)",
      "Bash(gh api */transfer*)",
      "Bash(gh api *Repository*)",
      "Bash(gh api *BranchProtection*)",
      "Bash(gh api *Ruleset*)",
      "Bash(gh api *mergeBranch*)",
      "Bash(gh api *Environment*)"
    ]
  }
}
