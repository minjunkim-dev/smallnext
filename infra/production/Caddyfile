{$API_DOMAIN} {
	encode zstd gzip
	handle_path /auth/captcha/* {
		root * /srv/smallnext-captcha
		header {
			Content-Security-Policy "default-src 'none'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src https://challenges.cloudflare.com; style-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
			Cache-Control "no-store"
			Referrer-Policy "no-referrer"
			X-Content-Type-Options "nosniff"
		}
		file_server
	}
	@site path /privacy /privacy/* /support /support/* /style.css
	handle @site {
		root * /srv/smallnext-site
		header {
			Content-Security-Policy "default-src 'none'; style-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
			Cache-Control "no-cache"
			Referrer-Policy "no-referrer"
			X-Content-Type-Options "nosniff"
		}
		file_server
	}
	handle {
		reverse_proxy api:8080
	}
}
