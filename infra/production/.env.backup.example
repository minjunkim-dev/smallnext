# Values stay empty. The systemd service reads /etc/smallnext/backup.env (0600).
# A Mac test may use a separate Git-excluded .env.backup; never install the example.
# Use the SELECT-only backup role. URL/CA are injected by the approved private path.
BACKUP_DATABASE_URL=
BACKUP_SSL_ROOT_CERT_FILE=
BACKUP_DIRECTORY=
BACKUP_RECIPIENTS_FILE=
# Only public age recipients belong on the server. Keep private identity on the Mac.
