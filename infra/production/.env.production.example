# Copy to .env.production outside Git. Fill values locally. Do not paste them into logs.
# Runtime LOGIN with smallnext_api membership only. Never use the schema owner here.
# Use sslmode=verify-full. Set sslrootcert to the read-only CA mount path if required.
DATABASE_URL=
API_DOMAIN=
SMALLNEXT_API_IMAGE=

# Production Compose fixes API_AUTO_MIGRATE=0. Run migrate with .env.migration separately.
# Configure the #170 encrypted budget backup separately: every 12h, at most 7 days,
# RPO/RTO 24h. Never put backup/migration credentials in this runtime file.

# USER_SERVER_AI is deliberately absent. Provider credentials belong to #242.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
AI_ALLOWED_SUPABASE_UIDS=
# #237 open beta: AI_PUBLIC_ACCESS=1 replaces the allowlist. Any other value keeps it.
# AI_PUBLIC_ACCESS=
# Random server-only value, at least 32 characters, e.g. `openssl rand -base64 48`. Never rotate mid-day.
AI_USAGE_HASH_KEY=
AI_MODEL_CONFIRMED=
ANTHROPIC_API_KEY=

# AI ON requires every key below; the API refuses to start without them. Set them only after #242 verification.
# AI_MODEL_CONTEXT_TOKENS=
# AI_MAX_OUTPUT_TOKENS=
# AI_INPUT_MICRO_USD_PER_MILLION=
# AI_OUTPUT_MICRO_USD_PER_MILLION=
# AI_BUDGET_MICRO_USD=
# AI_DAILY_BUDGET_MICRO_USD=
# AI_USER_DAILY_REQUESTS=
