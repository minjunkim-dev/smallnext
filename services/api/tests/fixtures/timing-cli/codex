#!/usr/bin/env python3
"""Synthetic simulator fixture. Never starts a model or reads credentials."""
import json
import pathlib
import sys
import time

args = sys.argv[1:]
schema = json.loads(pathlib.Path(args[args.index('--output-schema') + 1]).read_text())
payload = json.load(sys.stdin)
checking = 'verdict' in schema['properties']
kind = (payload['original_request'] if checking else payload).get('request_kind')
delayed = pathlib.Path(__file__).with_name('delay-first-action').is_file()
delay = 35 if (not checking and kind == 'first_action'
               and delayed) else .15
started = time.monotonic()
time.sleep(delay)
if delayed:
    with pathlib.Path(__file__).with_name('calls.jsonl').open('a') as file:
        file.write(json.dumps(dict(role='check' if checking else 'generate',
                                   request_kind=kind,
                                   configured_wait_seconds=delay,
                                   actual_wait_seconds=time.monotonic() - started,
                                   actual_model_calls=0, paid_calls=0)) + '\n')
if checking:
    value = dict(verdict='accept', criteria=[1, 2, 3, 4, 5], evidence='모의 검사', reason='모의 검증')
else:
    if kind == 'next_action':
        sys.exit(1)
    status = 'goal_summary' if kind == 'goal_preparation' else 'action'
    if kind == 'smaller' and len(payload['previous_proposals']) > 1:
        status = 'need_info'
    value = dict(status=status, facts=[], reduction='해당 없음', action='펜 하나 옮기기' if kind == 'smaller' else '펜 다섯 개 정리하기',
                 completion_condition='펜이 펜꽂이에 있다', estimated_minutes=min(payload['available_minutes'], 1 if kind == 'smaller' else 5),
                 reason='합성 모의 결과', remaining_work=payload['remaining_work'],
                 goal_completed=False, current_action_completed=False,
                 preserved_completed_ids=payload['completed_ids'])
    if kind == 'first_action' and payload['goal'].startswith('정보 부족 안내 검증'):
        value.update(status='insufficient_info', action='', completion_condition='', estimated_minutes=0,
                     reduction='', reason='현재 제공된 정보로는 **당시 역할**을 확인할 수 없어요.')
    if status == 'need_info':
        value['action'] = '펜꽂이가 어디 있나요?'
print(json.dumps({'type': 'item.completed', 'item': {'type': 'agent_message', 'text': json.dumps(value, ensure_ascii=False)}}))
print(json.dumps({'type': 'turn.completed'}))
